# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env.
#
# The defaults in docker-compose.yml already work, so this file is only needed
# when you want to change something. The two variables below are the ones
# compose actually reads; everything else here is documented for running the
# API or the frontend outside Docker.
# ---------------------------------------------------------------------------

# Seat hold lifetime in seconds (default 600 = 10 minutes)
HOLD_DURATION_SECONDS=600

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Running the API outside Docker (`dotnet run`), against the compose database:
# ---------------------------------------------------------------------------
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=school_admission;Username=postgres;Password=postgres
# ASPNETCORE_URLS=http://localhost:8080

# ---------------------------------------------------------------------------
# Running the frontend outside Docker (`npm run dev`):
# VITE_API_BASE_URL is baked in at build time, so leave it unset in dev and the
# Vite proxy forwards /api to the backend.
# ---------------------------------------------------------------------------
# VITE_DEV_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me
POSTGRES_DB=school_admission

# Backend connection string. Host is the compose service name, not localhost.
ConnectionStrings__Default=Host=db;Port=5432;Database=school_admission;Username=school;Password=change-me

# Seat hold lifetime in seconds (default 600 = 10 minutes)
HOLD_DURATION_SECONDS=600

# How often expired holds are swept to EXPIRED, in seconds
EXPIRY_SWEEP_SECONDS=15

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Backend listen address
ASPNETCORE_URLS=http://+:8080

# Frontend -> backend base URL, read at runtime by the browser
VITE_API_BASE_URL=http://localhost:8080

              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/holds/{{holdId}}",
              "host": ["{{baseUrl}}"],
              "path": ["holds", "{{holdId}}"]
            },
            "description": "Returns the current status. A lapsed hold reports EXPIRED even if nothing swept it."
          },
          "response": []
        },
        {
          "name": "GET /holds/{id} - unknown id (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]

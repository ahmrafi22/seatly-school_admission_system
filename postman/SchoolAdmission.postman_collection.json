    {
      "name": "06 - Cancel a hold",
      "item": [
        {
          "name": "Prepare: new class + hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('class created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cancelClassId', pm.response.json().id);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/classes/' + pm.collectionVariables.get('cancelClassId') + '/holds',",
                  "  method: 'POST',",
                  "  header: { 'X-Student-Id': '77777777777777777' }",
                  "}, (err, res) => {",
                  "  pm.test('hold created', () => pm.expect(res.code).to.eql(201));",
                  "  pm.collectionVariables.set('cancelHoldId', res.json().holdId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cancel Test Class\",\n  \"totalSeats\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] },
            "description": "Creates a throwaway class and hold so the delete can be tested without disturbing earlier state."
          },
          "response": []
        },
        {
          "name": "DELETE /holds/{id} - cancel (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('body is empty', () => pm.expect(pm.response.text()).to.be.oneOf(['', null]));",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/classes/' + pm.collectionVariables.get('cancelClassId'),",
                  "  method: 'GET'",
                  "}, (err, res) => {",
                  "  pm.test('seat returned to the pool', () => {",
                  "    pm.expect(res.json().heldSeats).to.eql(0);",
                  "  });",
                  "});"
                ]
              }
            }

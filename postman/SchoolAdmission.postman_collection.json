{
  "info": {
    "name": "GetSeatly - School Admission API",
    "_postman_id": "b7f3c2a1-4d5e-4f6a-9b8c-0d1e2f3a4b5c",
    "description": "Complete collection for the School Admission API. Covers all 8 contract endpoints plus error cases.\n\nRun in order: folders are numbered, and later requests rely on variables captured by earlier ones.\n\nBase URL is `{{baseUrl}}` (default http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "studentId", "value": "20152691234567890" },
    { "key": "classId", "value": "" },
    { "key": "holdId", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reports hold duration', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('holdDurationSeconds');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Not part of the 8-endpoint contract; useful to confirm the API is up."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Classes",
      "item": [
        {
          "name": "POST /classes - create class",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has required fields', () => {",
                  "  pm.expect(body).to.include.keys('id','name','totalSeats','heldSeats','confirmedSeats','availableSeats');",
                  "});",
                  "pm.test('starts empty', () => {",
                  "  pm.expect(body.heldSeats).to.eql(0);",
                  "  pm.expect(body.confirmedSeats).to.eql(0);",
                  "  pm.expect(body.availableSeats).to.eql(body.totalSeats);",
                  "});",
                  "pm.collectionVariables.set('classId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Class 6 - Morning Shift\",\n  \"totalSeats\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] },
            "description": "Creates a class with a fixed seat inventory. Stores the new id in {{classId}}."
          },
          "response": []
        },
        {
          "name": "POST /classes - reject blank name (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('has readable detail', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"   \",\n  \"totalSeats\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] },
            "description": "Validation: a class name is required."
          },
          "response": []
        },
        {
          "name": "POST /classes - reject zero seats (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Seats\",\n  \"totalSeats\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] },
            "description": "Validation: a class needs at least 1 seat."
          },
          "response": []
        },
        {
          "name": "GET /classes - list all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('not cached', () => {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] },
            "description": "Lists every class with live seat counts. Used by the UI to poll every few seconds."
          },
          "response": []
        },
        {
          "name": "GET /classes/{id} - single class",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('counts add up', () => {",
                  "  pm.expect(body.heldSeats + body.confirmedSeats + body.availableSeats).to.eql(body.totalSeats);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "{{classId}}"]
            },
            "description": "Returns one class with live seat counts."
          },
          "response": []
        },
        {
          "name": "GET /classes/{id} - unknown id (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/classes/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Unknown class ids return 404 with a readable message."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Apply for a seat",
      "item": [
        {
          "name": "POST /classes/{id}/holds - apply",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has required fields', () => {",
                  "  pm.expect(body).to.include.keys('holdId','classId','studentId','status','expiresAt');",
                  "});",
                  "pm.test('status is HELD', () => pm.expect(body.status).to.eql('HELD'));",
                  "pm.test('expiry is in the future', () => {",
                  "  pm.expect(new Date(body.expiresAt).getTime()).to.be.above(Date.now());",
                  "});",
                  "pm.collectionVariables.set('holdId', body.holdId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Student-Id", "value": "{{studentId}}" }],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/classes/{{classId}}/holds",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "{{classId}}", "holds"]
            },
            "description": "Reserves a seat. Requires X-Student-Id (17 digits). Stores the new hold id in {{holdId}}."
          },
          "response": []
        },
        {
          "name": "POST /classes/{id}/holds - missing header (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/classes/{{classId}}/holds",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "{{classId}}", "holds"]
            },
            "description": "Without X-Student-Id the request is rejected."
          },
          "response": []
        },
        {
          "name": "POST /classes/{id}/holds - malformed header (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Student-Id", "value": "12345" }],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/classes/{{classId}}/holds",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "{{classId}}", "holds"]
            },
            "description": "X-Student-Id must be exactly 17 digits."
          },
          "response": []
        },
        {
          "name": "POST /classes/{id}/holds - duplicate active (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('explains the conflict', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Student-Id", "value": "{{studentId}}" }],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/classes/{{classId}}/holds",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "{{classId}}", "holds"]
            },
            "description": "The same student cannot hold two active applications in one class."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Hold status",
      "item": [
        {
          "name": "GET /holds/{id} - current status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has required fields', () => {",
                  "  pm.expect(body).to.include.keys('holdId','classId','status','expiresAt');",
                  "});",
                  "pm.test('status is a known value', () => {",
                  "  pm.expect(['HELD','CONFIRMED','EXPIRED','CANCELLED']).to.include(body.status);",

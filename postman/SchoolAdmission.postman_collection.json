          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/holds/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["holds", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Unknown hold ids return 404."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Confirm admission",
      "item": [
        {
          "name": "POST /holds/{id}/confirm - pay fee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is CONFIRMED', () => pm.expect(body.status).to.eql('CONFIRMED'));",
                  "pm.test('returns the hold id', () => pm.expect(body.holdId).to.eql(pm.collectionVariables.get('holdId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Student-Id", "value": "{{studentId}}" }],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/holds/{{holdId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["holds", "{{holdId}}", "confirm"]
            },
            "description": "Confirms the admission after payment. Payment is assumed to have succeeded."
          },
          "response": []
        },
        {
          "name": "POST /holds/{id}/confirm - repeat is idempotent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('still CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/classes/' + pm.collectionVariables.get('classId'),",
                  "  method: 'GET'",
                  "}, (err, res) => {",
                  "  pm.test('confirmedSeats incremented once only', () => {",
                  "    pm.expect(res.json().confirmedSeats).to.eql(1);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Student-Id", "value": "{{studentId}}" }],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/holds/{{holdId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["holds", "{{holdId}}", "confirm"]
            },
            "description": "Repeating confirm must not increment confirmedSeats a second time."
          },
          "response": []
        },
        {
          "name": "POST /holds/{id}/confirm - wrong student (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Student-Id", "value": "99999999999999999" }],
            "body": { "mode": "none" },
            "url": {
              "raw": "{{baseUrl}}/holds/{{holdId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["holds", "{{holdId}}", "confirm"]
            },
            "description": "A student cannot confirm someone else's application. Returns 404 to avoid leaking existence."
          },
          "response": []
        }
      ]
    },

    {
      "name": "07 - Seat exhaustion (409)",
      "item": [
        {
          "name": "Fill a 1-seat class, then overflow",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('class created', () => pm.response.to.have.status(201));",
                  "const classId = pm.response.json().id;",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/classes/' + classId + '/holds',",
                  "  method: 'POST',",
                  "  header: { 'X-Student-Id': '60000000000000001' }",
                  "}, (err, res) => {",
                  "  pm.test('first applicant gets the seat', () => pm.expect(res.code).to.eql(201));",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/classes/' + classId + '/holds',",
                  "    method: 'POST',",
                  "    header: { 'X-Student-Id': '60000000000000002' }",
                  "  }, (err2, res2) => {",
                  "    pm.test('second applicant is rejected with 409', () => pm.expect(res2.code).to.eql(409));",
                  "    pm.test('message is human readable', () => {",
                  "      pm.expect(res2.json().detail).to.match(/no seats left/i);",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Single Seat Class\",\n  \"totalSeats\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] },
            "description": "Demonstrates the 409 when a class is full."
          },
          "response": []
        }
      ]
    }
  ]
}
